{
  "name": "lai-labs-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LAI Labs website (Vite + React + TypeScript)",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/release.mjs stamp",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "release:verify": "node scripts/release.mjs verify-artifact",
    "release:live": "node scripts/release.mjs verify-live"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "@playwright/test": "1.58.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
